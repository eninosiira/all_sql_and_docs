# ---- required -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---- model ----------------------------------------------------------------
# Set this to whichever model you want CRISpy to plan with. It is read at
# startup and never hardcoded, so moving to a newer model is an env change
# and a restart, not a code change.
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0

# ---- warehouse ------------------------------------------------------------
# CRISpy writes SQL. It does not execute it, so no Snowflake credentials are
# needed. These only label the generated SQL.
CRIS_DATABASE=AUDIENCE_DEV_DB
CRIS_SCHEMA=CRIS
